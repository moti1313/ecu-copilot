# Copy to .env (git-ignored). Never commit real keys.

# Provider: anthropic (default; tool runner, prompt caching, SDK tracing) or openai (hand-written loop)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Models default per provider: anthropic -> claude-opus-5-5 / judge claude-haiku-5-5,
#                              openai    -> gpt-5 / judge gpt-5-mini
# AGENT_MODEL=
# JUDGE_MODEL=
AGENT_EFFORT=medium

# Local development (defaults shown)
TWIN_URL=http://localhost:8001
JAEGER_UI_URL=http://localhost:16686
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# RAG_MODE=bm25   # skip the embedding model (tests / air-gapped)

# Jev shadow experiment (CONCEPT §12) - only used by evals/jev_shadow.py --send, never by the answer path
# TYPESAFE_API_KEY=

# Optional access control (off when empty). Same value for both is fine for the local demo.
# ECU_API_KEY=
# TWIN_API_KEY=
