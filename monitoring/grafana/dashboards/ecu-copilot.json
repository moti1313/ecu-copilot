{
 "uid": "ecu-copilot",
 "title": "ECU Copilot - Betrieb",
 "schemaVersion": 39,
 "version": 2,
 "editable": true,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "ecu-copilot"
 ],
 "panels": [
  {
   "id": 1,
   "title": "Fragen gesamt",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecu_copilot_questions_total",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "title": "Fehleranteil",
   "type": "stat",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecu_copilot_errors_total / clamp_min(ecu_copilot_questions_total, 1)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "title": "Kosten gesamt (berechnet)",
   "type": "stat",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecu_copilot_cost_usd_total",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 11,
   "title": "Copilot wird abgefragt (up)",
   "type": "stat",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"copilot\"}",
     "instant": true,
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "keine aktuellen Daten",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "nein",
         "color": "red"
        },
        "1": {
         "text": "ja",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "last"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "title": "Twin erreichbar (aktuell)",
   "type": "stat",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecu_copilot_twin_reachable",
     "instant": true,
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "keine aktuellen Daten",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "nein",
         "color": "red"
        },
        "1": {
         "text": "ja",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "last"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 5,
   "title": "Index bereit (aktuell)",
   "type": "stat",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecu_copilot_index_ready",
     "instant": true,
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "keine aktuellen Daten",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "nein",
         "color": "red"
        },
        "1": {
         "text": "ja",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "last"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 6,
   "title": "Antwortzeit, Mittel über gespeicherte Fragen",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecu_copilot_latency_seconds_sum / clamp_min(ecu_copilot_latency_seconds_count, 1)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 12,
   "title": "Antworten über 300 s",
   "type": "stat",
   "gridPos": {
    "x": 4,
    "y": 4,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecu_copilot_latency_seconds_count - ignoring(le) ecu_copilot_latency_seconds_bucket{le=\"300\"}",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "keine aktuellen Daten"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 7,
   "title": "Antwortzeit p95 (Schätzung aus Histogramm, gleitend 1 h)",
   "type": "timeseries",
   "gridPos": {
    "x": 8,
    "y": 4,
    "w": 16,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(ecu_copilot_latency_seconds_bucket[1h])) by (le))",
     "legendFormat": "p95 (1 h)"
    },
    {
     "refId": "B",
     "expr": "ecu_copilot_latency_seconds_sum / clamp_min(ecu_copilot_latency_seconds_count, 1)",
     "legendFormat": "Mittel über gespeicherte Fragen"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "title": "Token je Stunde",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(ecu_copilot_tokens_total[1h])",
     "legendFormat": "{{kind}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 9,
   "title": "Werkzeugaufrufe gesamt",
   "type": "bargauge",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ecu_copilot_tool_calls_total",
     "legendFormat": "{{tool}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 10,
   "title": "Fragen je Stunde",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(ecu_copilot_questions_total[1h])",
     "legendFormat": "Fragen"
    },
    {
     "refId": "B",
     "expr": "increase(ecu_copilot_errors_total[1h])",
     "legendFormat": "Fehler"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  }
 ]
}